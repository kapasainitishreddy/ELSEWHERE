# NOT USED for normal private gameplay (npm run dev).
# Optional, explicitly non-private remote-model demonstration (npm run dev:model).
# Each player's typed question + allowlisted fictional summary leaves the device only after UI consent.
# Select one server-side provider. Never commit .env, use a VITE_ key, or claim this mode is offline.
MODEL_PROVIDER=meta
# Meta Model API (pre-existing adapter):
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
# Baseten (documented partner adapter):
BASETEN_API_KEY=
BASETEN_MODEL=meta-models/muse-spark-open-1026
# Fireworks (choose a model ID explicitly from your authorized account):
FIREWORKS_API_KEY=
FIREWORKS_MODEL=
# Modal (use the exact HTTPS /v1/chat/completions URL shown by your authorized endpoint):
MODAL_PROXY_TOKEN=
MODAL_MODEL=
MODAL_CHAT_COMPLETIONS_URL=
HOST=127.0.0.1
PORT=8787
