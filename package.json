{
  "name": "syrava-elsewhere",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "ELSEWHERE: a playable alternate-lives world simulation for desktop and WebXR.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "node server.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "three": "^0.181.0"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "engines": {"node": ">=22"}
}
