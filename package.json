{
  "name": "syrava-elsewhere",
  "private": true,
  "version": "1.12.3",
  "type": "module",
  "description": "ELSEWHERE locally encrypted parallel worlds with optional CC0 scene assets and immersive WebXR",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && npm run build",
    "dev:api": "node server.mjs",
    "dev:meta": "node scripts/dev.mjs",
    "dev:local-ai": "node scripts/dev-local.mjs",
    "assets:fetch": "node scripts/vendor-kenney.mjs",
    "assets:check": "node --test tests/assets.test.mjs",
    "readiness": "node scripts/readiness.mjs",
    "dialogue:check": "node scripts/dialogue-quality.mjs",
    "motion:check": "node --test tests/motion-language.test.mjs tests/performance.test.mjs tests/kinetic-integration.test.mjs tests/performance-direction.test.mjs",
    "assets:animated": "node scripts/vendor-animated.mjs",
    "environment:check": "node --test tests/environment-motion.test.mjs tests/environment-integration.test.mjs",
    "animation:check": "node --test tests/actor-choreography.test.mjs tests/actor-integration.test.mjs tests/companion-integrity.test.mjs tests/performance-direction.test.mjs",
    "submission:check": "node scripts/submission-check.mjs",
    "npc:check": "node --test tests/npc-navigation.test.mjs",
    "world:check": "node --test tests/physics-playground.test.mjs tests/asset-interactions.test.mjs tests/npc-navigation.test.mjs",
    "play": "vite --host 0.0.0.0 --port 5173",
    "movement:check": "node --test tests/player-motion.test.mjs tests/actor-integration.test.mjs",
    "art:check": "node --test tests/character-finish.test.mjs tests/actor-choreography.test.mjs tests/player-motion.test.mjs tests/scene-art-runtime.test.mjs",
    "arena:check": "node --test tests/physics-playground.test.mjs tests/scene-art-runtime.test.mjs",
    "review:agents": "node tools/review/run.mjs",
    "review:source": "node tools/review/run.mjs --source-only"
  },
  "dependencies": {
    "three": "^0.181.0",
    "yuka": "^0.7.8",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "three-mesh-bvh": "^0.9.16"
  },
  "devDependencies": {
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
